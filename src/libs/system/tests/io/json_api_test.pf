  !   call json_api%init(error)
  !   call check_if_error_is_not_thrown(error)

  !   call json_api%put("=", 130_i4, error)
  !   call check_if_error_is_thrown(error)
  ! end subroutine put_test_incorrect2
  ! @test
  ! subroutine put_test_incorrect3
  ! implicit none (type, external)
  !   type(json_api_type) :: json_api
  !   type(exception_type) :: error

  !   call json_api%init(error)
  !   call check_if_error_is_not_thrown(error)

  !   call json_api%put("{123}", 130_i4, error)
  !   call check_if_error_is_thrown(error)
  ! end subroutine put_test_incorrect3

  @test
  subroutine exists_test_common
  implicit none (type, external)
    type(json_api_type) :: json_api
    type(exception_type) :: error

    logical :: res

    call json_api%init(error)
    call check_if_error_is_not_thrown(error)

    call json_api%load_from_string(json_common_1, error)
    call check_if_error_is_not_thrown(error)

    call json_api%exists("name", res, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = .true., &
      actual = res, &
      message = "incorrect result" &
    )

    call json_api%exists("scores", res, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = .true., &
      actual = res, &
      message = "incorrect result" &
    )

    call json_api%exists("scores(2)", res, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = .true., &
      actual = res, &
      message = "incorrect result" &
    )

    call json_api%exists("scores(20)", res, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = .false., &
      actual = res, &
      message = "incorrect result" &
    )


    call json_api%exists("donot_exists", res, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = .false., &
      actual = res, &
      message = "incorrect result" &
    )

    call json_api%exists("profile", res, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = .true., &
      actual = res, &
      message = "incorrect result" &
    )

    call json_api%exists("profile.email", res, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = .true., &
      actual = res, &
      message = "incorrect result" &
    )

    call json_api%exists("profile.skills", res, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = .true., &
      actual = res, &
      message = "incorrect result" &
    )

    call json_api%exists("profile.skills(3)", res, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = .true., &
      actual = res, &
      message = "incorrect result" &
    )

    call json_api%exists("profile.skills.donot_exists", res, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = .false., &
      actual = res, &
      message = "incorrect result" &
    )

    call json_api%exists("profile.skills(13)", res, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = .false., &
      actual = res, &
      message = "incorrect result" &
    )
  end subroutine exists_test_common

  @test
  subroutine exists_test_incorrect_path
  implicit none (type, external)
    type(json_api_type) :: json_api
    type(exception_type) :: error

    logical :: res

    call json_api%init(error)
    call check_if_error_is_not_thrown(error)

    call json_api%load_from_string(json_common_1, error)
    call check_if_error_is_not_thrown(error)

    call json_api%exists("{][32482]", res, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = .false., &
      actual = res, &
      message = "incorrect result" &
    )
  end subroutine exists_test_incorrect_path

  @test
  subroutine remove_test_common
  implicit none (type, external)
    type(json_api_type) :: json_api
    type(exception_type) :: error

    logical :: res

    call json_api%init(error)
    call check_if_error_is_not_thrown(error)

    call json_api%load_from_string(json_common_1, error)
    call check_if_error_is_not_thrown(error)

    call check_for("name")
    call check_for("scores")
    call check_for("profile.skills")
    call check_for("profile")

    contains

    subroutine check_for(path)
    implicit none (type, external)
      character(len = *), intent(in) :: path

      call json_api%remove(path, error)
      call check_if_error_is_not_thrown(error)
      call json_api%exists(path, res, error)
      call check_if_error_is_not_thrown(error)
      call assertEqual(&
        expected = .false., &
        actual = res, &
        message = "incorrect result" &
      )
    end subroutine check_for
  end subroutine remove_test_common

  @test
  subroutine remove_test_incorrect_path
  implicit none (type, external)
    type(json_api_type) :: json_api
    type(exception_type) :: error

    logical :: res

    call json_api%init(error)
    call check_if_error_is_not_thrown(error)

    call json_api%load_from_string(json_common_1, error)
    call check_if_error_is_not_thrown(error)

    call check_for("-=")
    call check_for("12-=")
    call check_for("profil[qw")

    contains

    subroutine check_for(path)
    implicit none (type, external)
      character(len = *), intent(in) :: path

      call json_api%remove(path, error)
      call check_if_error_is_thrown(error)
    end subroutine check_for
  end subroutine remove_test_incorrect_path

  @test
  subroutine get_element_type_test_common1
  implicit none (type, external)
    type(json_api_type) :: json_api
    type(exception_type) :: error

    integer(i1) :: type_id

    call json_api%init(error)
    call check_if_error_is_not_thrown(error)
    call json_api%load_from_string(json_common_3, error)
    call check_if_error_is_not_thrown(error)

    call json_api%get_element_type("name", type_id, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = JSON_TYPE_STRING, &
      actual = type_id, &
      message = "incorrect result" &
    )

    call json_api%get_element_type("age", type_id, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = JSON_TYPE_INTEGER, &
      actual = type_id, &
      message = "incorrect result" &
    )

    call json_api%get_element_type("height", type_id, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = JSON_TYPE_REAL, &
      actual = type_id, &
      message = "incorrect result" &
    )

    call json_api%get_element_type("isStudent", type_id, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = JSON_TYPE_BOOLEAN, &
      actual = type_id, &
      message = "incorrect result" &
    )

    call json_api%get_element_type("test_data", type_id, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = JSON_TYPE_NULL, &
      actual = type_id, &
      message = "incorrect result" &
    )

    call json_api%get_element_type("profile", type_id, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = JSON_TYPE_OBJECT, &
      actual = type_id, &
      message = "incorrect result" &
    )

    call json_api%get_element_type("profile.skills", type_id, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = JSON_TYPE_ARRAY, &
      actual = type_id, &
      message = "incorrect result" &
    )
  end subroutine get_element_type_test_common1

