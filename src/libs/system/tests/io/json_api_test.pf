  @test
  subroutine array_put_append_get_test_common_string
  implicit none (type, external)
    type(json_api_type) :: json_api
    type(exception_type) :: error

    type(string_type), allocatable :: values(:)
    character(len = *), parameter :: v1 = "string_1_test_123"
    character(len = *), parameter :: v2 = "string_2_test_12"
    character(len = *), parameter :: v3 = "string_3_test_1"
    character(len = *), parameter :: v_add = "string_4_test_12345"
    integer(i4) :: size_v

    call json_api%init(error)
    call check_if_error_is_not_thrown(error)
    call json_api%load_from_string(json_common_3, error)
    call check_if_error_is_not_thrown(error)

    allocate(values(3))
    values(1)%data = v1
    values(2)%data = v2
    values(3)%data = v3
    call json_api%array_put("array_test_1", values, error)
    deallocate(values)
    call check_if_error_is_not_thrown(error)

    call json_api%array_get("array_test_1", values, error)
    call check_if_error_is_not_thrown(error)
    call json_api%array_get_size("array_test_1", size_v, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = 3_i4, &
      actual = size_v, &
      message = "incorrect result" &
    )
    call assertEqual(&
      expected = 3_i4, &
      actual = size(values), &
      message = "incorrect result" &
    )
    call assertEqual(&
      expected = v1, &
      found = values(1)%data, &
      message = "incorrect result" &
    )
    call assertEqual(&
      expected = v2, &
      found = values(2)%data, &
      message = "incorrect result" &
    )
    call assertEqual(&
      expected = v3, &
      found = values(3)%data, &
      message = "incorrect result" &
    )
  end subroutine array_put_append_get_test_common_string

