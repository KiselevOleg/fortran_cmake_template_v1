  @test
  subroutine get_element_type_test_incorrect_path
  implicit none (type, external)
    type(json_api_type) :: json_api
    type(exception_type) :: error

    logical :: res
    integer(i1) :: type_id

    call reset()
    call json_api%get_element_type("[1]23erwg", type_id, error)
    call check_if_error_is_thrown(error)

    call reset()
    call json_api%is_integer("[1]23erwg", res, error)
    call check_if_error_is_thrown(error)

    call reset()
    call json_api%is_string("[1]23erwg", res, error)
    call check_if_error_is_thrown(error)

    call reset()
    call json_api%is_boolean("[1]23erwg", res, error)
    call check_if_error_is_thrown(error)

    call reset()
    call json_api%is_real("[1]23erwg", res, error)
    call check_if_error_is_thrown(error)

    call reset()
    call json_api%is_array("[1]23erwg", res, error)
    call check_if_error_is_thrown(error)

    call reset()
    call json_api%is_null("[1]23erwg", res, error)
    call check_if_error_is_thrown(error)

    call reset()
    call json_api%is_object("[1]23erwg", res, error)
    call check_if_error_is_thrown(error)

    contains
    subroutine reset()
    implicit none (type, external)
      call error%clear()
      call json_api%clear()

      call json_api%init(error)
      call check_if_error_is_not_thrown(error)
      call json_api%load_from_string(json_common_3, error)
      call check_if_error_is_not_thrown(error)
    end subroutine reset
  end subroutine get_element_type_test_incorrect_path

  @test
  subroutine array_put_append_get_test_common_int32
  implicit none (type, external)
    type(json_api_type) :: json_api
    type(exception_type) :: error

    integer(i4), allocatable :: values(:)
    integer(i4), parameter :: v1 = 1_i4
    integer(i4), parameter :: v2 = 2_i4
    integer(i4), parameter :: v3 = 3_i4
    integer(i4), parameter :: v_add = 5_i4
    integer(i4) :: size_v

    call json_api%init(error)
    call check_if_error_is_not_thrown(error)
    call json_api%load_from_string(json_common_3, error)
    call check_if_error_is_not_thrown(error)

    call json_api%array_put("array_test_1", [v1, v2, v3], error)
    call check_if_error_is_not_thrown(error)

    call json_api%array_get("array_test_1", values, error)
    call check_if_error_is_not_thrown(error)
    call json_api%array_get_size("array_test_1", size_v, error)
    call check_if_error_is_not_thrown(error)
    call assertEqual(&
      expected = 3_i4, &
      actual = size_v, &
      message = "incorrect result" &
    )
    call assertEqual(&
      expected = 3_i4, &
      actual = size(values), &
      message = "incorrect result" &
    )
    call assertEqual(&
      expected = v1, &
      actual = values(1), &
      message = "incorrect result" &
    )
    call assertEqual(&
      expected = v2, &
      actual = values(2), &
      message = "incorrect result" &
    )
    call assertEqual(&
      expected = v3, &
      actual = values(3), &
      message = "incorrect result" &
    )
  end subroutine array_put_append_get_test_common_int32

